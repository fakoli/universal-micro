+import { NextResponse } from "next/server";
+
+export const dynamic = "force-dynamic";
+
+// OpenAI-compatible speech-to-text upstream, configured by the operator.
+// Base URL is enough — the transcriptions path is appended when missing.
+const MAX_AUDIO_BYTES = 25 * 1024 * 1024;
+const UPSTREAM_TIMEOUT_MS = 120_000;
+
+function sttTranscriptionUrl(): string | null {
+  const base = process.env.PI_WEB_STT_URL?.trim();
+  if (!base) return null;
+  const trimmed = base.replace(/\/+$/, "");
+  return /audio\/transcriptions$/.test(trimmed) ? trimmed : `${trimmed}/v1/audio/transcriptions`;
+}
+
+// GET /api/stt — feature probe so the client can hide the mic button when no
+// STT server is configured.
+export async function GET() {
+  return NextResponse.json({ enabled: sttTranscriptionUrl() !== null });
+}
+
+/** Reads the request body with a hard byte cap, bounding chunked bodies too. */
+async function readBodyWithinLimit(request: Request, maxBytes: number): Promise<ArrayBuffer> {
+  // Per RFC 9112 the declared length is meaningless for chunked bodies; the
+  // streaming reader below is the only reliable cap in that case.
+  const isChunked = (request.headers.get("transfer-encoding") ?? "").toLowerCase().includes("chunked");
+  if (!isChunked) {
+    const declared = Number(request.headers.get("content-length") ?? "");
+    if (Number.isSafeInteger(declared) && declared > maxBytes) {
+      throw new Error("declared-too-large");
+    }
+  }
+  const reader = request.body?.getReader();
+  if (!reader) return new ArrayBuffer(0);
+
+  const chunks: Uint8Array[] = [];
+  let size = 0;
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    size += value.byteLength;
+    if (size > maxBytes) {
+      await reader.cancel().catch(() => {});
+      throw new Error("too-large");
+    }
+    chunks.push(value);
+  }
+  const buffer = new ArrayBuffer(size);
+  const body = new Uint8Array(buffer);
+  let offset = 0;
+  for (const chunk of chunks) {
+    body.set(chunk, offset);
+    offset += chunk.byteLength;
+  }
+  return buffer;
+}
+
+// POST /api/stt — proxies a WAV recording to the configured STT server and
+// returns { text }. Keeps the upstream URL server-side so it never reaches
+// the browser.
+export async function POST(request: Request) {
+  const upstreamUrl = sttTranscriptionUrl();
+  if (!upstreamUrl) {
+    return NextResponse.json(
+      { error: "Speech-to-text is not configured (set PI_WEB_STT_URL)" },
+      { status: 501 },
+    );
+  }
+
+  let audio: ArrayBuffer;
+  try {
+    audio = await readBodyWithinLimit(request, MAX_AUDIO_BYTES);
+  } catch {
+    return NextResponse.json({ error: "Audio recording too large" }, { status: 413 });
+  }
+  if (audio.byteLength === 0) {
+    return NextResponse.json({ error: "Empty audio recording" }, { status: 400 });
+  }
+
+  const contentType = request.headers.get("content-type")?.split(";")[0];
+  if (contentType !== "audio/wav") return NextResponse.json({ error: "Expected audio/wav" }, { status: 415 });
+  const form = new FormData();
+  form.append("file", new Blob([audio], { type: contentType }), "audio.wav");
+  form.append("response_format", "json");
+
+  try {
+    const upstream = await fetch(upstreamUrl, {
+      method: "POST",
+      body: form,
+      signal: AbortSignal.timeout(UPSTREAM_TIMEOUT_MS),
+    });
+    if (!upstream.ok) {
+      return NextResponse.json(
+        { error: `STT server error (${upstream.status})` },
+        { status: 502 },
+      );
+    }
+    const payload = await upstream.json().catch(() => null) as { text?: unknown } | null;
+    if (!payload || typeof payload.text !== "string") {
+      return NextResponse.json({ error: "Unexpected STT server response" }, { status: 502 });
+    }
+    return NextResponse.json({ text: payload.text });
+  } catch {
+    return NextResponse.json(
+      { error: "Could not reach the configured speech server" },
+      { status: 502 },
+    );
+  }
+}
