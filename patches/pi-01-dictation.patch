+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { blobToWav16kMono } from "@/lib/audio-wav";
+
+export type VoiceInputState = "idle" | "requesting" | "recording" | "transcribing" | "error";
+
+/** Releases shorter than this are treated as accidental taps, not dictation. */
+const MIN_RECORDING_MS = 250;
+/** Hard cap on a single hold; the hook stops recording on its own past this. */
+const MAX_RECORDING_MS = 5 * 60 * 1000;
+/** How long the error state (and its banner) stays visible before resetting. */
+const ERROR_RESET_MS = 6000;
+/** Recordings smaller than this cannot contain usable speech. */
+const MIN_AUDIO_BYTES = 512;
+
+function pickRecorderMimeType(): string | undefined {
+  if (typeof MediaRecorder === "undefined" || !MediaRecorder.isTypeSupported) return undefined;
+  const candidates = ["audio/webm;codecs=opus", "audio/webm", "audio/ogg;codecs=opus", "audio/mp4"];
+  return candidates.find((type) => MediaRecorder.isTypeSupported(type));
+}
+
+/**
+ * Push-to-talk dictation for the chat composer.
+ *
+ * `start()` requests the microphone and begins recording; `stop()` ends the
+ * recording, converts it to 16 kHz mono WAV in the browser and POSTs it to
+ * /api/stt. The recognized text is delivered through `onTranscript`. No
+ * streaming partials — the transcript arrives once, after release.
+ */
+export function useVoiceInput(onTranscript: (text: string) => void) {
+  const [state, setState] = useState<VoiceInputState>("idle");
+  const [error, setError] = useState<string | null>(null);
+  const [supported, setSupported] = useState(false);
+
+  const stateRef = useRef(state);
+  useEffect(() => { stateRef.current = state; }, [state]);
+
+  const onTranscriptRef = useRef(onTranscript);
+  useEffect(() => { onTranscriptRef.current = onTranscript; }, [onTranscript]);
+
+  const mountedRef = useRef(true);
+  const recorderRef = useRef<MediaRecorder | null>(null);
+  const streamRef = useRef<MediaStream | null>(null);
+  const chunksRef = useRef<Blob[]>([]);
+  const startedAtRef = useRef(0);
+  const stopRequestedRef = useRef(false);
+  const cancelledRef = useRef(false);
+  /** True once the in-flight getUserMedia promise is being tracked for cleanup. */
+  const pendingStartRef = useRef(false);
+  const maxDurationTimerRef = useRef<number | null>(null);
+  const errorTimersRef = useRef<number[]>([]);
+
+  useEffect(() => {
+    mountedRef.current = true;
+    setSupported(typeof MediaRecorder !== "undefined" && !!navigator.mediaDevices?.getUserMedia);
+    return () => {
+      mountedRef.current = false;
+      cancelledRef.current = true;
+      // A getUserMedia that resolves after unmount stops its own tracks via
+      // cancelledRef; pendingStartRef keeps the intent visible for debugging.
+      void pendingStartRef.current;
+      recorderRef.current?.stream.getTracks().forEach((track) => track.stop());
+      streamRef.current?.getTracks().forEach((track) => track.stop());
+      if (maxDurationTimerRef.current !== null) window.clearTimeout(maxDurationTimerRef.current);
+      errorTimersRef.current.forEach((timer) => window.clearTimeout(timer));
+    };
+  }, []);
+
+  const reportError = useCallback((message: string) => {
+    if (!mountedRef.current) return;
+    errorTimersRef.current.forEach((timer) => window.clearTimeout(timer));
+    errorTimersRef.current = [];
+    setError(message);
+    setState("error");
+    const timer = window.setTimeout(() => {
+      errorTimersRef.current = errorTimersRef.current.filter((t) => t !== timer);
+      if (mountedRef.current && stateRef.current === "error") {
+        setError(null);
+        setState("idle");
+      }
+    }, ERROR_RESET_MS);
+    errorTimersRef.current.push(timer);
+  }, []);
+
+  const transcribe = useCallback(async (blob: Blob) => {
+    setState("transcribing");
+    try {
+      const wav = await blobToWav16kMono(blob);
+      const response = await fetch("/api/stt", {
+        method: "POST",
+        body: wav,
+        headers: { "Content-Type": "audio/wav" },
+      });
+      if (!response.ok) {
+        const payload = await response.json().catch(() => null) as { error?: string } | null;
+        throw new Error(payload?.error || `Transcription failed (${response.status})`);
+      }
+      const payload = await response.json() as { text?: string };
+      const text = (payload.text ?? "").trim();
+      if (text) onTranscriptRef.current(text);
+      if (mountedRef.current) setState("idle");
+    } catch (err) {
+      reportError(err instanceof Error ? err.message : String(err));
+    }
+  }, [reportError]);
+
+  const start = useCallback(async () => {
+    if (stateRef.current !== "idle" && stateRef.current !== "error") return;
+    errorTimersRef.current.forEach((timer) => window.clearTimeout(timer));
+    errorTimersRef.current = [];
+    setError(null);
+    stopRequestedRef.current = false;
+    cancelledRef.current = false;
+    setState("requesting");
+    try {
+      pendingStartRef.current = true;
+      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
+      pendingStartRef.current = false;
+      if (cancelledRef.current) {
+        // Released or unmounted while the permission prompt / device open was
+        // in flight — the stream would otherwise keep running (mic LED on).
+        stream.getTracks().forEach((track) => track.stop());
+        if (mountedRef.current) setState("idle");
+        return;
+      }
+      streamRef.current = stream;
+      const mimeType = pickRecorderMimeType();
+      const recorder = new MediaRecorder(stream, mimeType ? { mimeType } : undefined);
+      chunksRef.current = [];
+      recorder.ondataavailable = (event) => {
+        if (event.data.size > 0) chunksRef.current.push(event.data);
+      };
+      recorder.onstop = () => {
+        stream.getTracks().forEach((track) => track.stop());
+        streamRef.current = null;
+        if (maxDurationTimerRef.current !== null) {
+          window.clearTimeout(maxDurationTimerRef.current);
+          maxDurationTimerRef.current = null;
+        }
+        const blob = new Blob(chunksRef.current, { type: recorder.mimeType || "audio/webm" });
+        chunksRef.current = [];
+        recorderRef.current = null;
+        if (cancelledRef.current || !mountedRef.current) {
+          if (mountedRef.current) setState("idle");
+          return;
+        }
+        const elapsed = Date.now() - startedAtRef.current;
+        if (elapsed < MIN_RECORDING_MS || blob.size < MIN_AUDIO_BYTES) {
+          setState("idle");
+          return;
+        }
+        void transcribe(blob);
+      };
+      recorderRef.current = recorder;
+      startedAtRef.current = Date.now();
+      recorder.start();
+      if (stopRequestedRef.current) {
+        // Released before the recorder was ready — stop immediately; the
+        // short-elapsed guard in onstop discards the clip.
+        recorder.stop();
+      } else {
+        setState("recording");
+        maxDurationTimerRef.current = window.setTimeout(() => {
+          if (recorderRef.current?.state === "recording") recorderRef.current.stop();
+        }, MAX_RECORDING_MS);
+      }
+    } catch (err) {
+      streamRef.current?.getTracks().forEach((track) => track.stop());
+      streamRef.current = null;
+      reportError(err instanceof Error ? err.message : String(err));
+    }
+  }, [reportError, transcribe]);
+
+  const stop = useCallback(() => {
+    const recorder = recorderRef.current;
+    if (recorder && recorder.state === "recording") {
+      recorder.stop();
+      return;
+    }
+    if (stateRef.current === "requesting") stopRequestedRef.current = true;
+  }, []);
+
+  return { state, error, supported, start, stop, recording: state === "recording" };
+}
