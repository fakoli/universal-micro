+/** Browser audio conversion to bounded 16 kHz mono PCM16 WAV. */
+export const WAV_SAMPLE_RATE = 16_000;
+
+/** Default cap for dictated clips; prevents runaway uploads from a stuck hold. */
+export const MAX_DICTATION_SECONDS = 300;
+
+type MonoSampleSource = {
+  numberOfChannels: number;
+  getChannelData(channel: number): Float32Array;
+};
+
+/**
+ * Downmix an AudioBuffer (or anything shaped like one) to a single channel by
+ * averaging all channels sample-by-sample.
+ */
+export function audioBufferToMonoSamples(buffer: MonoSampleSource): Float32Array {
+  if (buffer.numberOfChannels === 1) return buffer.getChannelData(0);
+  const channels: Float32Array[] = [];
+  for (let channel = 0; channel < buffer.numberOfChannels; channel += 1) {
+    channels.push(buffer.getChannelData(channel));
+  }
+  const length = channels[0].length;
+  const mono = new Float32Array(length);
+  for (let i = 0; i < length; i += 1) {
+    let sum = 0;
+    for (const channel of channels) sum += channel[i];
+    mono[i] = sum / channels.length;
+  }
+  return mono;
+}
+
+/**
+ * Encode float samples (-1..1) as a mono 16-bit PCM WAV blob.
+ */
+export function encodeWavBlob(samples: Float32Array, sampleRate: number): Blob {
+  const dataBytes = samples.length * 2;
+  const buffer = new ArrayBuffer(44 + dataBytes);
+  const view = new DataView(buffer);
+
+  const writeAscii = (offset: number, text: string) => {
+    for (let i = 0; i < text.length; i += 1) view.setUint8(offset + i, text.charCodeAt(i));
+  };
+
+  writeAscii(0, "RIFF");
+  view.setUint32(4, 36 + dataBytes, true);
+  writeAscii(8, "WAVE");
+  writeAscii(12, "fmt ");
+  view.setUint32(16, 16, true);          // fmt chunk size
+  view.setUint16(20, 1, true);           // PCM
+  view.setUint16(22, 1, true);           // mono
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * 2, true); // byte rate
+  view.setUint16(32, 2, true);           // block align
+  view.setUint16(34, 16, true);          // bits per sample
+  writeAscii(36, "data");
+  view.setUint32(40, dataBytes, true);
+
+  let offset = 44;
+  for (let i = 0; i < samples.length; i += 1) {
+    const clamped = Math.max(-1, Math.min(1, samples[i]));
+    view.setInt16(offset, clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff, true);
+    offset += 2;
+  }
+
+  return new Blob([view], { type: "audio/wav" });
+}
+
+/**
+ * Decode any browser-recorded audio blob into a 16 kHz mono WAV blob.
+ * decodeAudioData resamples to the OfflineAudioContext's sample rate, so the
+ * OfflineAudioContext doubles as the resampler without touching the shared
+ * AudioContext used for notification tones.
+ */
+export async function blobToWav16kMono(
+  blob: Blob,
+  maxDurationSeconds: number = MAX_DICTATION_SECONDS,
+): Promise<Blob> {
+  const arrayBuffer = await blob.arrayBuffer();
+  const decodeContext = new OfflineAudioContext(1, 1, WAV_SAMPLE_RATE);
+  const decoded = await decodeContext.decodeAudioData(arrayBuffer);
+  const samples = audioBufferToMonoSamples(decoded);
+  const maxSamples = WAV_SAMPLE_RATE * Math.max(0, maxDurationSeconds);
+  const trimmed = samples.length > maxSamples ? samples.subarray(0, maxSamples) : samples;
+  return encodeWavBlob(trimmed, WAV_SAMPLE_RATE);
+}
